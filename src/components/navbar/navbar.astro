---
import Container from "@/components/container.astro";
import { Astronav, MenuIcon } from "astro-navbar";
import { Image } from "astro:assets";
import heroImage from "@/assets/hero.png";


---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-4">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center" aria-label="Pet Prime">
          <Image
            src={heroImage}
            alt="Pet Prime"
            width={118}
            height={117}
            loading="eager"
            class="h-20 w-auto object-contain md:h-24"
          />
        </a>

      </div>
     
    </Astronav>
   
  </header>
</Container>
